{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/world/:path*", "destination": "/" },
    { "source": "/projects/:path*", "destination": "/" },
    { "source": "/writing/:path*", "destination": "/" },
    { "source": "/playbox", "destination": "/" }
  ],
  "functions": {
    "api/github-pinned.js": {
      "maxDuration": 20
    }
  }
}
